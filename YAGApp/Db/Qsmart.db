record (longout, $(R)QS:Delay){
   field(DESC, "Flashlamp to Q-Switch delay")
   field(DTYP, "stream")
   field(OUT,  "@Qsmart.proto setQDLY $(PORT) $(A)")
   field(EGU,  "ns")
   field(DRVL, "0")
   field(DRVH, "255")
   field(FLNK, "$(R)QS:Delay_RBV.PROC")
   field(PINI, "YES")
}
record (longin, $(R)QS:Delay_RBV){
   field(DESC, "Flashlamp to Q-Switch delay readback")
   field(DTYP, "stream")
   field(INP,  "@Qsmart.proto getQDLY $(PORT) $(A)")
   field(EGU,  "ns")
   field(PINI, "YES")
}

record (longout, $(R)QS:SyncOutDelay){
   field(DESC, "Q-Switch sync-out delay")
   field(DTYP, "stream")
   field(OUT,  "@Qsmart.proto setQDLYO $(PORT) $(A)")
   field(EGU,  "ns")
   field(DRVL, "-500")
   field(DRVH, "500")
   field(FLNK, "$(R)QS:SyncOutDelay_RBV.PROC")
   field(PINI, "YES")
}
record (longin, $(R)QS:SyncOutDelay_RBV){
   field(DESC, "Q-Switch sync-out delay readback")
   field(DTYP, "stream")
   field(INP,  "@Qsmart.proto getQDLYO $(PORT) $(A)")
   field(EGU,  "ns")
   field(PINI, "YES")
}

record (bo, $(R)QS:Enable){
   field(DESC, "Start/stop Q-Switch (laser) emission")
   field(DTYP, "stream")
   field(OUT,  "@Qsmart.proto setQSW $(PORT) $(A)")
   field(ZNAM, "Off")
   field(ONAM, "On")
}
