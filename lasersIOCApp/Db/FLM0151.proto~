Terminator = CR LF;
fget = ":SYSTem:WADJust:WAVelength?";
fset = ":SYSTem:WADJust:WAVelength %f";
vget = ":SYStem:PDRive:VOLTage?";
vset = ":SYStem:PDRive:VOLTage %f";
tget = ":SYStem:TCONtrol2:SPOint?";
tset = ":SYStem:TCONtrol2:SPOint %f";

getF{
  out $fget;
  in "%f";
}

setF{
  ExtraInput = Ignore;
  out $fset;
  @init{ getF; }
}

pwdenable{
  out ":SYStem:PASSword:CENable \"NP\"";
}

getV{
  out $vget;
  in "%f";
  @init{ pwdenable; }
}

setV{
  out $vset;
  @init { getV; }
}

getT{
  out $tget;
  in "%f";
  @init{ pwdenable; }
}

setT{
  out $tset;
  @init { getT; }
}
