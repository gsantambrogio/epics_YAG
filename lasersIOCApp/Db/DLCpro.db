record(ao, $(R)set:offset){
   field(DESC, "Set scan offset")
   field(DTYP, "stream")
   field(OUT, "@DLCpro.proto setF(X) $(PORT) $(A)")
   field(VAL, "59.0")
   field(PINI, "YES")
 }
record(ai, $(R)get:offset){
   field(DESC, "Query scan offset")
   field(DTYP, "stream")
   field(INP, "@DLCpro.proto getF $(PORT) $(A)")
#   field(FLNK,"$(R)set:offset")
   field(PINI, "YES")
   field(SCAN, "1 second")
}
