record (ao, $(R)setWL){
   field(DESC, "Set wavelength")
   field(DTYP, "stream")
   field(OUT, "@FLM0151.proto setF(X) $(PORT) $(A)")
   field(FLNK,"$(R)getWL.PROC")
   field(PINI, "YES")
 }
record (ai, $(R)getWL){
   field(DESC, "Query wavelenght")
   field(DTYP, "stream")
   field(INP, "@FLM0151.proto getF $(PORT) $(A)")
   field(PINI, "YES") 
}

